<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Environment variable defaults - can be overridden at deployment time -->
    <property name="LOG_LEVEL_ROOT" value="${LOG_LEVEL_ROOT:-INFO}"/>
    <property name="LOG_LEVEL_APP" value="${LOG_LEVEL_APP:-INFO}"/>
    <property name="LOG_LEVEL_SPRING" value="${LOG_LEVEL_SPRING:-WARN}"/>
    <property name="LOG_LEVEL_SECURITY" value="${LOG_LEVEL_SECURITY:-WARN}"/>
    <property name="LOG_LEVEL_SQL" value="${LOG_LEVEL_SQL:-WARN}"/>
    <property name="LOG_LEVEL_HIKARI" value="${LOG_LEVEL_HIKARI:-WARN}"/>
    <property name="LOG_LEVEL_MESSAGING" value="${LOG_LEVEL_MESSAGING:-WARN}"/>
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-TEXT}"/>
    <property name="SERVICE_NAME" value="${spring.application.name:-iqscaffold-user-service}"/>
    <property name="ENVIRONMENT" value="${SPRING_PROFILES_ACTIVE:-unknown}"/>
    
    <!-- Console Appender - Text Format (for local/dev) -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-}] [%X{traceId:-}] [%X{spanId:-}] [%X{tenantId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Console Appender - JSON Format (for staging/production) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <version/>
                <logLevel/>
                <message/>
                <mdc/>
                <arguments/>
                <stackTrace/>
                <pattern>
                    <pattern>
                        {
                        "service": "${SERVICE_NAME}",
                        "environment": "${ENVIRONMENT}",
                        "thread": "%thread"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>
    
    <!-- Async wrapper for console appender (better performance) -->
    <appender name="ASYNC_CONSOLE_TEXT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE_TEXT"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>
    
    <appender name="ASYNC_CONSOLE_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE_JSON"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>
    
    <!-- Conditional appender selection based on LOG_FORMAT -->
    <if condition='property("LOG_FORMAT").equals("JSON")'>
        <then>
            <appender name="CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
                <appender-ref ref="CONSOLE_JSON"/>
                <queueSize>512</queueSize>
                <discardingThreshold>0</discardingThreshold>
            </appender>
        </then>
        <else>
            <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-}] [%X{traceId:-}] [%X{spanId:-}] [%X{tenantId:-}] %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </else>
    </if>
    
    <!-- Application Loggers - controlled by environment variables -->
    <logger name="com.iqscaffold" level="${LOG_LEVEL_APP}"/>
    <logger name="org.springframework.security" level="${LOG_LEVEL_SECURITY}"/>
    <logger name="org.springframework.web" level="${LOG_LEVEL_SPRING}"/>
    <logger name="org.springframework.amqp" level="${LOG_LEVEL_MESSAGING}"/>
    <logger name="org.springframework.rabbit" level="${LOG_LEVEL_MESSAGING}"/>
    <logger name="org.springframework.data.redis" level="${LOG_LEVEL_SPRING}"/>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_SQL}"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="${LOG_LEVEL_SQL}"/>
    <logger name="com.zaxxer.hikari" level="${LOG_LEVEL_HIKARI}"/>
    <logger name="liquibase" level="INFO"/>
    
    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>