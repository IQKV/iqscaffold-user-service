        <!-- Assign authorities to users via user_authorities junction table -->
        
        <!-- 1. SUPER_ADMIN authority for superadmin user -->
        <insert tableName="user_authorities">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE username = 'superadmin')"/>
            <column name="authority_id" valueComputed="(SELECT id FROM public.authorities WHERE name = 'SUPER_ADMIN')"/>
        </insert>

