# IQ Scaffold User Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Database Configuration (iqscaffold.database prefix)
# =============================================================================
IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://localhost:5432/iqscaffold_user_local
IQSCAFFOLD_DATABASE_USERNAME=iqscaffold_user
IQSCAFFOLD_DATABASE_PASSWORD=iqscaffold_password

# =============================================================================
# Redis Cache Configuration (iqscaffold.cache.redis prefix)
# =============================================================================
IQSCAFFOLD_CACHE_REDIS_HOST=localhost
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=
IQSCAFFOLD_CACHE_REDIS_DATABASE=0

# =============================================================================
# S3/MinIO Object Storage Configuration (iqscaffold.object-storage prefix)
# =============================================================================
IQSCAFFOLD_OBJECTSTORAGE_ENDPOINT=http://localhost:9000
IQSCAFFOLD_OBJECTSTORAGE_ACCESS_KEY=minioadmin
IQSCAFFOLD_OBJECTSTORAGE_SECRET_KEY=minioadmin
IQSCAFFOLD_OBJECTSTORAGE_BUCKET_NAME=user-avatars
IQSCAFFOLD_OBJECTSTORAGE_REGION=us-east-1
IQSCAFFOLD_OBJECTSTORAGE_SSL=false
IQSCAFFOLD_OBJECTSTORAGE_UPLOAD_MAX_FILE_SIZE_BYTES=5242880
IQSCAFFOLD_OBJECTSTORAGE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
IQSCAFFOLD_OBJECTSTORAGE_UPLOAD_PRESIGNED_URL_EXPIRATION_MINUTES=60

# =============================================================================
# Authentication Configuration (iqscaffold.auth prefix)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# =============================================================================
# Observability Configuration (iqscaffold.observability prefix)
# =============================================================================
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Local Development Environment
# SPRING_PROFILES_ACTIVE=local
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://localhost:5432/iqscaffold_user_local
# IQSCAFFOLD_CACHE_REDIS_HOST=localhost
# JWT_SECRET_KEY=local-development-secret-key-not-for-production-use

# Staging Environment
# SPRING_PROFILES_ACTIVE=staging
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://staging-db:5432/iqscaffold_user_staging
# IQSCAFFOLD_CACHE_REDIS_HOST=staging-redis
# JWT_SECRET_KEY=${VAULT_JWT_SECRET}

# Production Environment
# SPRING_PROFILES_ACTIVE=production
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://production-db:5432/iqscaffold_user_production
# IQSCAFFOLD_CACHE_REDIS_HOST=prod-redis
# JWT_SECRET_KEY=${VAULT_JWT_SECRET}
